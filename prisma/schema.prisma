generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadType {
  RESIDENTIAL
  B2B
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  LOST
}

model Category {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  slug           String    @unique
  shippingType   String
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id             Int       @id @default(autoincrement())
  name           String
  slug           String    @unique
  description    String
  price          Int
  image          String
  isFeatured     Boolean   @default(false)
  categoryId     Int
  category       Category  @relation(fields: [categoryId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Lead {
  id             Int        @id @default(autoincrement())
  name           String
  whatsapp       String
  city           String?
  productInterest String?
  type           LeadType   @default(RESIDENTIAL)
  businessName   String?
  quantity       String?
  message        String?
  status         LeadStatus @default(NEW)
  source         String     @default("website")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ShippingRate {
  id             Int      @id @default(autoincrement())
  province       String
  city           String
  priceLabel     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([province, city])
}

model JournalPost {
  id             Int      @id @default(autoincrement())
  title          String
  slug           String   @unique
  excerpt        String
  content        String
  image          String?
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PortfolioProject {
  id             Int      @id @default(autoincrement())
  title          String
  slug           String   @unique
  location       String
  description    String
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
